# ======================================
# ОПТИМИЗИРОВАННАЯ КОНФИГУРАЦИЯ PIGWEIGHT
# ======================================

# GPU и аппаратное ускорение
CUDA_ENABLED=true
CUDA_DEVICE=0
USE_HALF_PRECISION=true
ENABLE_H264_DIRECT=true

# AsyncRTSPDecoder конфигурация
RTSP_CONNECTION_TIMEOUT=5000
RTSP_READ_TIMEOUT=1000
RTSP_MAX_RETRIES=3
RTSP_RETRY_DELAY=2.0
RTSP_BUFFER_SIZE=3

# PriorityFrameQueue настройки
FRAME_QUEUE_MAX_SIZE=1000
FRAME_QUEUE_MAX_MEMORY_MB=200
FRAME_QUEUE_DROP_THRESHOLD=0.8
FRAME_QUEUE_MAX_AGE_SECONDS=2.0
FRAME_QUEUE_CLEANUP_INTERVAL=1.0

# DynamicBatcher конфигурация
BATCH_MIN_SIZE=1
BATCH_MAX_SIZE=16
BATCH_INITIAL_SIZE=4
BATCH_TARGET_LATENCY_MS=50.0
BATCH_MAX_WAIT_MS=100.0
BATCH_ADAPTATION_INTERVAL=2.0
BATCH_THROUGHPUT_WEIGHT=0.7
BATCH_WARMUP_BATCHES=10

# AdaptiveQualityController
QUALITY_INITIAL_LEVEL=HIGH
QUALITY_CPU_THRESHOLD_HIGH=80.0
QUALITY_CPU_THRESHOLD_LOW=60.0
QUALITY_MEMORY_THRESHOLD_HIGH=85.0
QUALITY_MEMORY_THRESHOLD_LOW=70.0
QUALITY_GPU_THRESHOLD_HIGH=90.0
QUALITY_GPU_THRESHOLD_LOW=70.0
QUALITY_ADAPTATION_INTERVAL=2.0
QUALITY_COOLDOWN_PERIOD=10.0
QUALITY_LATENCY_THRESHOLD_MS=100.0

# PerformanceMonitor настройки
MONITOR_METRICS_INTERVAL=1.0
MONITOR_WEBSOCKET_PORT=8765
MONITOR_MAX_HISTORY_MINUTES=60
MONITOR_ENABLE_ALERTS=true
MONITOR_ALERT_CPU_THRESHOLD=90.0
MONITOR_ALERT_MEMORY_THRESHOLD=95.0
MONITOR_ALERT_LATENCY_THRESHOLD=200.0

# H.264 настройки для разных уровней качества
# ULTRA качество
H264_ULTRA_BITRATE=4000000
H264_ULTRA_PRESET=slow
H264_ULTRA_PROFILE=high
H264_ULTRA_LEVEL=4.0

# HIGH качество (BALANCED профиль по умолчанию)
H264_HIGH_BITRATE=3000000
H264_HIGH_PRESET=medium
H264_HIGH_PROFILE=main
H264_HIGH_LEVEL=3.1

# MEDIUM качество
H264_MEDIUM_BITRATE=1500000
H264_MEDIUM_PRESET=fast
H264_MEDIUM_PROFILE=baseline
H264_MEDIUM_LEVEL=3.1

# LOW качество
H264_LOW_BITRATE=1000000
H264_LOW_PRESET=faster
H264_LOW_PROFILE=baseline
H264_LOW_LEVEL=3.0

# MINIMAL качество
H264_MINIMAL_BITRATE=500000
H264_MINIMAL_PRESET=ultrafast
H264_MINIMAL_PROFILE=baseline
H264_MINIMAL_LEVEL=2.1

# WebRTC оптимизации
WEBRTC_ENABLE_DIRECT_H264=true
WEBRTC_MAX_BITRATE=4000000
WEBRTC_MIN_BITRATE=500000
WEBRTC_TARGET_DELAY_MS=50
WEBRTC_MAX_PACKET_SIZE=1200

# Оптимизация сети
NETWORK_BUFFER_SIZE_KB=64
NETWORK_SO_SNDBUF_KB=128
NETWORK_SO_RCVBUF_KB=128
NETWORK_TCP_NODELAY=true
NETWORK_TCP_KEEPALIVE=true

# Оптимизация памяти
MEMORY_POOL_SIZE_MB=512
MEMORY_ENABLE_MMAP=true
MEMORY_PREALLOC_FRAMES=100

# Производительность инференса - CUDA 12.9 оптимизация
INFERENCE_ENGINE=pytorch
INFERENCE_OPTIMIZE_FOR_LATENCY=true
INFERENCE_ENABLE_TENSORRT=true
INFERENCE_DYNAMIC_SHAPES=true
CUDA_VERSION=12.9
CUDNN_VERSION=8.9

# Логирование производительности
PERF_LOG_ENABLED=true
PERF_LOG_INTERVAL=10
PERF_LOG_LEVEL=INFO
PERF_LOG_FILE=logs/performance.log

# Мониторинг и метрики
METRICS_EXPORT_PROMETHEUS=false
METRICS_EXPORT_INFLUXDB=false
METRICS_RETENTION_HOURS=24

# Экспериментальные функции
EXPERIMENTAL_ZERO_COPY=true
EXPERIMENTAL_BATCH_NORMALIZATION=true
EXPERIMENTAL_FRAME_PREDICTION=false

# Fallback конфигурация
FALLBACK_ENABLE_MJPEG=true
FALLBACK_JPEG_QUALITY=75
FALLBACK_MAX_CONNECTIONS=4

# Безопасность
SECURITY_ENABLE_AUTH=false
SECURITY_JWT_SECRET=your-secret-key
SECURITY_SESSION_TIMEOUT=3600