# PigWeight - Оптимизированная конфигурация
# Автоматически применяется при использовании main_optimized.py

# Профиль производительности (переопределяется автоматическим выбором)
# ULTRA_PERFORMANCE, BALANCED, POWER_SAVING, CPU_ONLY
PERFORMANCE_PROFILE=BALANCED

# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# Автоматический выбор устройства (cuda:0, cpu, auto)
DEVICE=auto

# Производительность (переопределяется профилем)
TARGET_FPS=60
BATCH_MAX_SIZE=16
BATCH_TARGET_LATENCY_MS=50
USE_HALF=true

# Модель
MODEL_PATH=models/pig_yolo11-seg.v4.pt
DETECTION_MODE=pig-only
CONF_THRESHOLD=0.30

# Видео
FPS=25
JPEG_QUALITY=90
IMG_SIZE=960

# Обработка
LINE_LEFT_X=0.25
LINE_RIGHT_X=0.75
AVG_WINDOW=20
FRAME_SKIP=3

# ONNX Runtime (переопределяется автоматическим выбором)
PREFER_ONNX=auto
ONNX_PROVIDER=auto

# Логирование
LOG_LEVEL=WARNING