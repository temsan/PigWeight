# Конфигурация для production сервера (VM без GPU)
# Машина: QEMU Virtual CPU 2.5+ (2 cores, 2.60 GHz), 8GB RAM, NO GPU

# ============================================
# ПРОИЗВОДИТЕЛЬНОСТЬ (CPU-ONLY режим)
# ============================================

# Устройство - только CPU (нет GPU на VM)
DEVICE=cpu
USE_HALF=false

# Целевой FPS - минимальный для экономии CPU
TARGET_FPS=10

# Размер изображения - минимальный для CPU
IMG_SIZE=640

# Батчинг - минимальный для слабого CPU
BATCH_MAX_SIZE=1
BATCH_TARGET_LATENCY_MS=500

# Пропуск кадров - обрабатываем каждый 5-й кадр
FRAME_SKIP=5

# ============================================
# RTSP НАСТРОЙКИ
# ============================================

# Таймауты для медленной сети (32 Kbps)
RTSP_TIMEOUT=60

# Качество JPEG - снижено для экономии CPU и сети
JPEG_QUALITY=70

# ============================================
# СЕРВЕР
# ============================================

HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# ============================================
# МОДЕЛЬ
# ============================================

MODEL_PATH=models/pig_yolo11-seg.v4.pt
CONF_THRESHOLD=0.30

# ============================================
# ЛОГИРОВАНИЕ
# ============================================

# Минимальное логирование для production
LOG_LEVEL=WARNING

# ============================================
# ОПТИМИЗАЦИЯ ДЛЯ СЛАБОГО CPU
# ============================================

# Отключаем WebRTC (требует много CPU)
ENABLE_WEBRTC=false

# Отключаем демо генератор
ENABLE_DEMO=false

# Минимальное окно усреднения
AVG_WINDOW=10

# Увеличенный cooldown для снижения нагрузки
CROSS_COOLDOWN_SEC=2.0

# ============================================
# БАЗА ДАННЫХ (опционально)
# ============================================

# Если нужна БД, раскомментируйте:
# SUPABASE_URL=your_url
# SUPABASE_KEY=your_key

# ============================================
# ПРИМЕЧАНИЯ
# ============================================

# Эта конфигурация оптимизирована для:
# - Виртуальной машины без GPU
# - 2 CPU ядра @ 2.60 GHz
# - 8 GB RAM
# - Медленной сети (32 Kbps)
#
# Ожидаемая производительность:
# - FPS: 5-10 (зависит от нагрузки)
# - Задержка: 1-2 секунды
# - Использование CPU: 60-80%
# - Использование RAM: 2-3 GB
#
# Для улучшения производительности:
# 1. Используйте физический сервер с GPU
# 2. Увеличьте количество CPU ядер
# 3. Улучшите сетевое подключение
# 4. Используйте локальные видеофайлы вместо RTSP
