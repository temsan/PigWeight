# Оптимизированная конфигурация PigWeight
# Скопируйте этот файл в .env для применения настроек

# Model Configuration
MODEL_PATH=models/pig_yolo11-seg.v4.pt
DETECTION_MODE=pig-only
PIG_CLASS_ID=0
CONF_THRESHOLD=0.30

# Device Configuration
DEVICE=cuda:0
USE_HALF=true

# Inference Configuration
IMG_SIZE=960
BATCH_SIZE=8
MAX_WAIT_MS=50

# 🚀 НОВАЯ ОПТИМИЗИРОВАННАЯ ПРЕДОБРАБОТКА
# Соответствует датасету с center crop и черными полосами
USE_OPTIMIZED_PREPROCESSING=true

# Методы предобработки:
# - adaptive: автоматический выбор (рекомендуется)
# - center_crop: принудительный center crop с черными полосами
# - letterbox: старый метод с сохранением пропорций
PREPROCESSING_METHOD=adaptive

# ВАЖНО: Отключить ANTI_LETTERBOX для избежания конфликтов
ANTI_LETTERBOX=false

# Broker and Results Configuration
FRAME_BROKER_CACHE=16
RESULTS_TTL_SECONDS=30
BROADCAST_MIN_INTERVAL=0.05

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# Video Configuration
FPS=12
JPEG_QUALITY=80

# Lines for Counting
LINE_LEFT_X=0.25
LINE_RIGHT_X=0.75

# Дополнительные настройки
AVG_WINDOW=20
FRAME_SKIP=3
USE_HSV=false
