# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=true

# Event Logging Configuration
SAVE_FRAMES=false              # Не сохранять кадры
LOG_ACTIVITY_SPIKES=false      # Не писать в файлы
LOG_PEAK_COUNTS=false          # Не писать в файлы
LOG_LINE_CROSSINGS=false       # Не писать в файлы
ENABLE_EVENT_LOGGER=false      # Отключить файловое журналирование полностью

# Camera Configuration
CAM_DEFAULT=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_URL=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_CH101=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_CH102=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/102

# Video/Image Configuration
JPEG_QUALITY=80
FPS=12

# Model Configuration
MODEL_PATH=models/pig_yolo11-seg.v4.pt
DETECTION_MODE=pig-only
PIG_CLASS_ID=0
TARGET_CLASS_IDS=20,17,19
CONF_THRESHOLD=0.30
AVG_WINDOW=20
FRAME_SKIP=1              # Меньше пропусков = больше нагрузка на GPU

# Device Configuration
DEVICE=cuda:0
USE_HALF=true
IMG_SIZE=960

# Inference Configuration
BATCH_SIZE=32             # Максимальный батч для RTX 2050
MAX_WAIT_MS=20            # Минимальное ожидание

# Broker and Results Configuration
FRAME_BROKER_CACHE=16
RESULTS_TTL_SECONDS=30
BROADCAST_MIN_INTERVAL=0.1

# Legacy optional toggles (ignored by current build)

# Lines for Counting
LINE_LEFT_X=0.25
LINE_RIGHT_X=0.75

# Auxiliary settings
ULTRA_IMG_SIZE=320
ULTRA_CONF=0.4
ULTRA_DEVICE=auto
ULTRA_HALF=auto
ULTRA_SKIP_N=3

MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt
ONNX_PATH=models/pig_yolo11-seg.v4.onnx

GOOGLE_CLOUD_PROJECT=gemin-470309

