# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=true

# Camera Configuration
CAM_DEFAULT=demo://test
CAM_URL=demo://test
CAM_CH101=demo://test
CAM_CH102=demo://test

# Video/Image Configuration
JPEG_QUALITY=80
FPS=24

# Model Configuration
MODEL_PATH=models/pig_yolo11-seg.v4.pt
TARGET_CLASS_IDS=20,17,19
CONF_THRESHOLD=0.30
AVG_WINDOW=20
FRAME_SKIP=3

DEVICE=cuda:0
USE_HALF=true
IMG_SIZE=960

ULTRA_IMG_SIZE=320
ULTRA_CONF=0.4
ULTRA_DEVICE=auto
ULTRA_HALF=auto
ULTRA_SKIP_N=3

# Model Download URLs
MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt
ONNX_PATH=models/yolo11n.onnx 

GOOGLE_CLOUD_PROJECT=gemin-470309

# Architecture Optimization
USE_OPTIMIZED_PREPROCESSING=true
ANTI_LETTERBOX=false