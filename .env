# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
RELOAD=true

# Camera Configuration
CAM_DEFAULT=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_URL=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_CH101=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/101
CAM_CH102=rtsp://rtsp:Qwerty.12!@10.15.6.27:554/ISAPI/Streaming/Channels/102

# Video/Image Configuration
JPEG_QUALITY=80
FPS=12

# Model Configuration
MODEL_PATH=models/pig_yolo11-seg.v4.pt
DETECTION_MODE=pig-only
PIG_CLASS_ID=0
TARGET_CLASS_IDS=20,17,19
CONF_THRESHOLD=0.30
AVG_WINDOW=20
FRAME_SKIP=3

# Device Configuration (оптимизировано для стабильности)
DEVICE=cpu
USE_HALF=false
IMG_SIZE=960

# Inference Configuration (оптимизировано)
BATCH_SIZE=8
MAX_WAIT_MS=50

# Broker and Results Configuration
FRAME_BROKER_CACHE=16
RESULTS_TTL_SECONDS=30
BROADCAST_MIN_INTERVAL=0.1

ULTRA_IMG_SIZE=320
ULTRA_CONF=0.4
ULTRA_DEVICE=auto
ULTRA_HALF=auto
ULTRA_SKIP_N=3

# Model Download URLs
MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolo11n.pt
ONNX_PATH=models/yolo11n.onnx 

GOOGLE_CLOUD_PROJECT=gemin-470309

# 🚀 ОПТИМИЗИРОВАННАЯ ПРЕДОБРАБОТКА
USE_OPTIMIZED_PREPROCESSING=true
PREPROCESSING_METHOD=adaptive
ANTI_LETTERBOX=false

# Lines for Counting
LINE_LEFT_X=0.25
LINE_RIGHT_X=0.75BATCH_SIZE=8
FPS=30
BROADCAST_MIN_INTERVAL=0.033
