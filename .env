# Production конфигурация для VM (2 CPU, 8GB RAM, NO GPU)
# Автоматически сгенерировано для деплоя

# ============================================
# БАЗА ДАННЫХ - ОТКЛЮЧЕНА
# ============================================
DB_REQUIRED=false

# ============================================
# ПРОИЗВОДИТЕЛЬНОСТЬ (CPU-ONLY режим)
# ============================================
DEVICE=cpu
USE_HALF=false
TARGET_FPS=10
IMG_SIZE=640
BATCH_MAX_SIZE=1
BATCH_TARGET_LATENCY_MS=500
FRAME_SKIP=5

# ============================================
# RTSP НАСТРОЙКИ
# ============================================
RTSP_TIMEOUT=60
JPEG_QUALITY=70

# ============================================
# СЕРВЕР
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false

# ============================================
# МОДЕЛЬ
# ============================================
MODEL_PATH=models/pig_yolo11-seg.v4.pt
CONF_THRESHOLD=0.30

# ============================================
# ОПТИМИЗАЦИЯ ДЛЯ СЛАБОГО CPU
# ============================================
ENABLE_WEBRTC=false
ENABLE_DEMO=false
AVG_WINDOW=10
CROSS_COOLDOWN_SEC=2.0
