# Исключения - важные файлы, которые нужно сохранить
!.gitkeep
!README.md
!example_*.py
!test_*.py

# Сохраняем структуру папок
!uploads/.gitkeep
!models/.gitkeep
!records/.gitkeep
!results/.gitkeep
!screenshots/.gitkeep
!temp/.gitkeep

# Исключения для важных SVG (иконки, не скриншоты)
!static/favicon.svg
!static/icons/*.svg
!docs/*.svg
/models/

